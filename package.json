{
  "name": "ai-for-developers-project-386",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.6.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "generate": "pnpm --filter @calendar/api generate",
    "build": "pnpm -r build",
    "lint": "oxlint --deny-warnings",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter e2e test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "husky": "^9.1.7",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
